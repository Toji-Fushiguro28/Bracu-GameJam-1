  lines:
  - id: 
    speaker: 
    text: Hi! Is the reading room always this cozy?
    next: 
    choices:
    - text: Always.
      next: cozy
    - text: Only when the fire's lit.
      next: fire
  - id: cozy
    speaker: 
    text: Then I'm moving in. Kidding! ...Mostly.
    next: end
    choices: []
  - id: fire
    speaker: 
    text: Then never let it go out, okay?
    next: end
    choices: []
