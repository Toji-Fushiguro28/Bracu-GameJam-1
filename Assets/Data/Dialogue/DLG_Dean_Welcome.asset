  m_Script: {fileID: 11500000, guid: f0404ccca8e5452469fb3665d0764664, type: 3}
  m_Name: DLG_Dean_Welcome
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  speaker: Dean Whitmore
  voicePitch: 0.8
  lines:
  - id: 
    speaker: 
    text: Ah, the new librarian! Welcome to Whitmore Library.
    next: 
    choices: []
  - id: 
    speaker: 
    text: Tell me, do you know your way around?
    next: 
    choices:
    - text: Show me the ropes.
      next: tour
    - text: I'll figure it out.
      next: confident
  - id: tour
    speaker: 
    text: 'Every book lives on its subject''s shelf: Science, History, Philosophy and Math.'
    next: tip
    choices: []
  - id: confident
    speaker: 
    text: Ha! I like your spirit. Just don't keep the patrons waiting.
    next: tip
    choices: []
  - id: tip
    speaker: 
    text: And whatever you do... the rare books are never, ever for sale.
    next: end
    choices: []
