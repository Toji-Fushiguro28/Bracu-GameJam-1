<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../UI Toolkit/PC.uss" />
    <ui:VisualElement name="container">
        <ui:VisualElement name="books-window" class="pc-window">
            <ui:VisualElement class="pc-header">
                <ui:Button name="back-button" text="&lt; Back" class="pc-button" />
                <ui:Label text="CATALOGUE" class="pc-title font-title" />
                <ui:Button name="buy-books-button" text="Buy books" class="pc-button pc-header-button" />
            </ui:VisualElement>
            <ui:VisualElement class="pc-columns">
                <ui:VisualElement class="pc-left">
                    <ui:VisualElement name="search-wrap" class="pc-search">
                        <ui:TextField name="book-search" />
                        <ui:Label name="search-placeholder" text="search title, author or tag" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="pc-filters">
                        <ui:Button name="filter-subject" text="Subject: All" class="pc-button pc-filter" />
                        <ui:Button name="filter-type" text="Type: All" class="pc-button pc-filter" />
                    </ui:VisualElement>
                    <ui:ListView name="books-list" selection-type="Single" fixed-item-height="96" />
                </ui:VisualElement>
                <ui:VisualElement name="book-details" class="pc-right">
                    <ui:Label name="detail-empty" text="Select a book to see where it lives." class="detail-empty" />
                    <ui:VisualElement name="detail-body">
                        <ui:Label name="detail-title" class="detail-title" />
                        <ui:Label name="detail-author" class="detail-author" />
                        <ui:VisualElement class="detail-row"><ui:Label text="Shelf" class="detail-key" /><ui:Label name="detail-shelf" class="detail-value" /></ui:VisualElement>
                        <ui:VisualElement class="detail-row"><ui:Label text="In stock" class="detail-key" /><ui:Label name="detail-stock" class="detail-value" /></ui:VisualElement>
                        <ui:VisualElement class="detail-row"><ui:Label text="Type" class="detail-key" /><ui:Label name="detail-type" class="detail-value" /></ui:VisualElement>
                        <ui:VisualElement class="detail-row"><ui:Label text="Subject" class="detail-key" /><ui:Label name="detail-subject" class="detail-value" /></ui:VisualElement>
                        <ui:VisualElement class="detail-row"><ui:Label text="Tags" class="detail-key" /><ui:Label name="detail-tags" class="detail-value" /></ui:VisualElement>
                        <ui:VisualElement class="detail-row"><ui:Label text="Tier" class="detail-key" /><ui:Label name="detail-tier" class="detail-value" /></ui:VisualElement>
                        <ui:VisualElement class="detail-row"><ui:Label text="Condition" class="detail-key" /><ui:Label name="detail-condition" class="detail-value" /></ui:VisualElement>
                        <ui:VisualElement class="detail-row"><ui:Label text="Sale" class="detail-key" /><ui:Label name="detail-sale" class="detail-value" /></ui:VisualElement>
                        <ui:Label name="detail-abstract" class="detail-abstract" />
                        <ui:VisualElement class="detail-actions">
                            <ui:Button name="detail-select" text="Add to note" class="pc-button detail-select" />
                            <ui:Button name="detail-buy" text="Buy" class="pc-button detail-select detail-buy" />
                        </ui:VisualElement>
                        <ui:Label name="detail-select-note" class="detail-select-note" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
