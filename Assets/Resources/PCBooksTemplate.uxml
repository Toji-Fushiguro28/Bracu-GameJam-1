<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="catalogue" class="cat">
        <ui:VisualElement class="cat-col">
            <ui:VisualElement name="search-wrap" class="pc-search">
                <ui:TextField name="book-search" class="pc-input" />
                <ui:Label name="search-placeholder" text="search title, author or tag" picking-mode="Ignore" class="pc-placeholder" />
            </ui:VisualElement>
            <ui:VisualElement class="pc-filters">
                <ui:Button name="filter-type" text="Type: All" class="pc-button small" />
                <ui:Button name="filter-subject" text="Subject: pick a type first" class="pc-button small" />
                <ui:Button name="filter-show" text="Show: All" class="pc-button small" />
            </ui:VisualElement>
            <ui:Label name="book-count" class="count-line" />
            <ui:ListView name="books-list" selection-type="Single" fixed-item-height="104" class="book-list" />
        </ui:VisualElement>
        <ui:VisualElement name="book-details" class="cardpane">
            <ui:Label name="detail-empty" text="Select a book to see where it lives, read its abstract, or order more." class="detail-empty" />
            <ui:VisualElement name="detail-body" class="detail-body">
                <ui:Label name="detail-callno" class="callno font-title" />
                <ui:Label name="detail-stamp" class="stamp font-title" picking-mode="Ignore" />
                <ui:VisualElement name="detail-top" class="cardtop">
                    <ui:Label name="detail-title" class="detail-title font-title" />
                    <ui:Label name="detail-author" class="detail-author" />
                    <ui:VisualElement name="detail-tags" class="detail-tags" />
                </ui:VisualElement>
                <ui:ScrollView name="detail-scroll" class="pc-scroll detail-scroll">
                    <ui:VisualElement class="facts">
                        <ui:VisualElement class="fact"><ui:VisualElement class="fact-icon fi-shelf" /><ui:Label text="Shelf" class="fact-key" /><ui:Label name="detail-shelf" class="fact-value" /></ui:VisualElement>
                        <ui:VisualElement class="fact alt"><ui:VisualElement class="fact-icon fi-stock" /><ui:Label text="Stock" class="fact-key" /><ui:Label name="detail-stock" class="fact-value" /><ui:VisualElement name="detail-cart" class="fact-cart"><ui:Label text="·" class="meta-sep" /><ui:VisualElement class="px-icon icon-cart" /><ui:Label name="detail-cart-n" class="fact-value" /></ui:VisualElement></ui:VisualElement>
                        <ui:VisualElement class="fact"><ui:VisualElement name="detail-condition-icon" class="fact-icon fi-condition" /><ui:Label text="Condition" class="fact-key" /><ui:Label name="detail-condition" class="fact-value" /></ui:VisualElement>
                        <ui:VisualElement class="fact alt"><ui:VisualElement class="fact-icon fi-coin" /><ui:Label text="Sells for" class="fact-key" /><ui:Label name="detail-sale" class="fact-value" /></ui:VisualElement>
                        <ui:VisualElement name="detail-status-row" class="fact"><ui:VisualElement class="fact-icon fi-status" /><ui:Label text="Status" class="fact-key" /><ui:Label name="detail-status" class="fact-value" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="about-box">
                        <ui:VisualElement class="about-head"><ui:VisualElement class="fact-icon fi-about" /><ui:Label text="ABOUT THIS BOOK" class="abstract-label" /></ui:VisualElement>
                        <ui:Label name="detail-abstract" class="detail-abstract" />
                    </ui:VisualElement>
                    <ui:Label name="detail-reserve" class="reserve" />
                </ui:ScrollView>
                <ui:VisualElement class="detail-actions">
                    <ui:VisualElement class="detail-btns">
                        <ui:Button name="detail-select" text="Add to note" class="pc-button" />
                        <ui:Button name="detail-buy" class="pc-button"><ui:Label text="Order" class="btn-text" picking-mode="Ignore" /><ui:Label text="-" class="btn-text cost-minus" picking-mode="Ignore" /><ui:VisualElement class="coin-icon small" picking-mode="Ignore" /><ui:Label name="buy-price" class="btn-text" picking-mode="Ignore" /></ui:Button>
                        <ui:Button name="detail-express" class="pc-button"><ui:Label text="Express" class="btn-text" picking-mode="Ignore" /><ui:Label text="-" class="btn-text cost-minus" picking-mode="Ignore" /><ui:VisualElement class="coin-icon small" picking-mode="Ignore" /><ui:Label name="express-price" class="btn-text" picking-mode="Ignore" /></ui:Button>
                    </ui:VisualElement>
                    <ui:Label name="detail-select-note" class="detail-msg" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
