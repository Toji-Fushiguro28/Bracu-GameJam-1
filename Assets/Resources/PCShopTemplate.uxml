<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="shop">
        <ui:VisualElement class="sub-tabs">
            <ui:Button name="tab-upgrades" text="Upgrades" class="sub-tab font-title" />
            <ui:Button name="tab-staff" text="Staff" class="sub-tab font-title" />
        </ui:VisualElement>
        <ui:ScrollView name="shop-list" class="pc-scroll shop-list" />
        <ui:Label name="shop-note" class="page-note" />
    </ui:VisualElement>
</ui:UXML>
