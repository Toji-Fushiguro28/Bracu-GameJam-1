/* Notebook on the right edge of the screen: same paper popup as the dialogue box. */
.notebook-layer {
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-end;
    padding-top: 104px; /* under the coin purse */
}
/* A shelf, cart, return bin, repair desk or notice board is open: start below its × (NotebookHUD). */
.notebook-layer.below-close { padding-top: 280px; }
.notebook {
    flex-direction: row;
    align-items: flex-start;
    transition-property: translate;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}
/* Collapsed: the page slides off the right edge, only the tab stays. */
.notebook.collapsed { translate: 446px 0; }
/* Collapsed, a box takes only its tab's height: Reserved moves up under the Notes tab, and Notes get the room. */
.notebook.collapsed { max-height: 80px; }

.notebook-tab {
    margin-top: 28px;
    margin-right: -6px;
    font-size: 22px;
}
.notebook-page {
    width: 430px;
    margin-right: 16px;
    flex-shrink: 1;
    padding: 24px 22px 20px 24px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 6px;
}
.notebook-title { color: var(--ink); font-size: 30px; margin-bottom: 6px; -unity-text-align: middle-center; }
.notebook-list { flex-grow: 0; flex-shrink: 1; }

.nb-entry {
    padding: 6px 0 8px 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(128, 92, 70, 0.35);
}
.nb-line { color: var(--ink); font-size: 20px; white-space: normal; }
.nb-hint { color: var(--accent); font-size: 19px; white-space: normal; }
.nb-guess { color: var(--ink-soft); font-size: 19px; white-space: normal; }
.nb-clear { align-self: flex-end; margin-top: 4px; }
.nb-empty { color: var(--ink-soft); font-size: 19px; white-space: normal; -unity-text-align: middle-center; margin: 10px 0; }
.nb-warn { color: rgb(170, 60, 40); font-size: 19px; white-space: normal; }

/* Reservations: same look, right under the Notes, starts collapsed. */
.reservations {
    margin-top: 10px;
}
.reservations .notebook-tab { margin-top: 14px; }
.reservations .notebook-page { padding-top: 16px; }
.reservations .notebook-title { font-size: 26px; margin-bottom: 2px; }
/* New reservation: gold tab that pulses until you open the list. */
.notebook-tab.new {
    color: rgb(255, 246, 232);
    background-image: url("project://database/Assets/Art/UI/PC/T_PC_ButtonHot.png");
    transition-property: scale;
    transition-duration: 0.4s;
}
.notebook-tab.new.pulse { scale: 1.15 1.15; }

/* Long lists scroll (with the kit scroll bar) instead of running off the screen.
   Their max heights are set from the screen's height in NotebookHUD.FitLists. */
.notebook-list { max-height: 560px; }
.reservations .notebook-list { max-height: 220px; }
