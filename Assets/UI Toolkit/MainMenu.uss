/* Main menu: an open book over the library, which drifts by behind it. */
.menu-root {
    align-items: center;
    justify-content: center;
    transition-property: opacity;
    transition-duration: 0.6s;
}
.menu-root.fading { opacity: 0; }

.menu-vignette {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(24, 14, 10, 0.38);
}

.menu-book {
    translate: 0 0;
    scale: 1 1;
    transition-property: translate, scale, opacity;
    transition-duration: 0.6s;
    transition-timing-function: ease-out-back;
}
.menu-book.intro { translate: 0 60px; scale: 0.92 0.92; opacity: 0; }

/* ---------- Left page ---------- */
.menu-left { align-items: center; justify-content: center; }
.menu-stars { flex-direction: row; align-items: flex-end; margin-bottom: 6px; }
.menu-star {
    width: 22px; height: 22px; margin: 0 6px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconStar01a.png");
}
.menu-star.big { width: 32px; height: 32px; }
.menu-title {
    color: var(--ink);
    font-size: 60px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin: 0 4px;
}
.menu-subtitle { color: var(--ink-soft); font-size: 24px; -unity-text-align: middle-center; margin-top: 2px; }
.menu-divider {
    width: 70%; height: 6px; margin: 22px 0 18px 0;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Line01a.png");
    -unity-slice-left: 2; -unity-slice-right: 2;
    -unity-slice-scale: 3px;
}
.menu-save { color: var(--ink); font-size: 23px; -unity-text-align: middle-center; white-space: normal; }
.menu-tip { color: var(--ink-soft); font-size: 19px; -unity-text-align: middle-center; white-space: normal; margin-top: 14px; max-width: 320px; }
.menu-footer { position: absolute; bottom: 28px; color: var(--ink-soft); font-size: 17px; opacity: 0.8; }

/* ---------- Right page ---------- */
.menu-right { justify-content: center; }
.menu-panel { flex-grow: 1; justify-content: center; }
.menu-button {
    align-self: stretch;
    margin: 7px 18px;
    font-size: 30px;
    padding: 8px 14px 12px 14px;
    -unity-text-align: middle-center;
    transition-property: scale, translate;
    transition-duration: 0.12s;
}
.menu-button:hover { scale: 1.05 1.05; translate: 0 -2px; color: rgb(255, 246, 232); }
.menu-button:active { scale: 0.97 0.97; }
.menu-button.small-gap { margin-top: 14px; font-size: 26px; }
.menu-text { color: var(--ink); font-size: 22px; white-space: normal; -unity-text-align: middle-center; margin: 6px 14px 18px 14px; }

.menu-settings { margin: 4px 6px; }
.menu-setting { flex-direction: row; align-items: center; margin: 8px 0; }
.menu-setting-name { color: var(--ink); font-size: 22px; width: 104px; }
.menu-setting-value { color: var(--ink); font-size: 21px; flex-grow: 1; -unity-text-align: middle-center; }
.menu-setting .kit-button { font-size: 20px; padding: 4px 10px 6px 10px; min-width: 34px; -unity-text-align: middle-center; -unity-slice-scale: 2px; }
.menu-pips { flex-direction: row; flex-grow: 1; justify-content: center; }
.menu-pip {
    width: 15px; height: 18px; margin: 0 2px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Slot01a.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 2; -unity-slice-bottom: 2;
    -unity-slice-scale: 2px;
}
.menu-pip.on { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Fill01a.png"); }

.menu-credits { flex-grow: 1; max-height: 380px; margin: 0 8px; }
.credit-head { color: var(--accent); font-size: 22px; -unity-text-align: middle-center; margin-top: 10px; }
.credit-line { color: var(--ink); font-size: 19px; -unity-text-align: middle-center; white-space: normal; }

.menu-hint {
    position: absolute; bottom: 24px;
    color: rgb(250, 240, 220);
    font-size: 20px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(40, 30, 20);
    opacity: 0.85;
}
.howto-text { color: var(--ink); font-size: 20px; white-space: normal; margin: 4px 10px; flex-grow: 1; min-height: 300px; }
.howto-nav { flex-direction: row; align-items: center; justify-content: center; }
.howto-arrow { font-size: 26px; padding: 0 14px 6px 14px; margin: 0 10px; }
.howto-page { color: var(--ink-soft); font-size: 20px; min-width: 60px; -unity-text-align: middle-center; }
.credit-name { color: var(--ink); font-size: 21px; -unity-text-align: middle-center; margin-top: 6px; }
.credit-role { color: var(--ink-soft); font-size: 17px; -unity-text-align: middle-center; }

/* ---------- Mode picker ---------- */
.mode-card {
    align-self: stretch;
    margin: 6px 16px;
    padding: 8px 14px 12px 14px;
    align-items: center;
    transition-property: scale, translate;
    transition-duration: 0.12s;
}
.mode-card:hover { scale: 1.04 1.04; translate: 0 -2px; }
.mode-card:active { scale: 0.97 0.97; }
.mode-card.recommended {
    background-image: url("project://database/Assets/Art/UI/PC/T_PC_Button.png");
    padding-top: 6px;
    margin-bottom: 12px;
}
.mode-badge { color: var(--accent); font-size: 18px; -unity-text-align: middle-center; }
.mode-name { color: var(--ink); font-size: 30px; -unity-text-align: middle-center; }
.mode-card.recommended .mode-name { font-size: 34px; color: var(--accent); }
.mode-info { color: var(--ink-soft); font-size: 17px; white-space: normal; -unity-text-align: middle-center; }

/* ---------- How to Play: flashier pages ---------- */
.howto-body {
    flex-grow: 1;
    transition-property: opacity, translate;
    transition-duration: 0.28s;
    transition-timing-function: ease-out-cubic;
}
.howto-body.turn { opacity: 0; translate: 26px 0; }
.howto-body.turn-back { opacity: 0; translate: -26px 0; }
.howto-head { flex-direction: row; align-items: center; justify-content: center; margin: 2px 0 4px 0; flex-shrink: 0; }
.howto-icon {
    width: 40px; height: 40px; margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: rotate, scale;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}
.howto-icon.pop { rotate: -12deg; scale: 1.25 1.25; }
.howto-title { color: var(--accent); font-size: 36px; flex-shrink: 0; } /* full line height, so the text centres on the icon */
.howto-rule {
    height: 6px; margin: 2px 30px 10px 30px; flex-shrink: 0;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Line01a.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-scale: 3px;
}
.howto-dots { flex-direction: row; justify-content: center; margin: 4px 0 6px 0; }
.howto-dot {
    width: 10px; height: 10px; margin: 0 4px;
    border-width: 2px; border-color: var(--ink-soft);
    border-top-left-radius: 5px; border-top-right-radius: 5px;
    border-bottom-left-radius: 5px; border-bottom-right-radius: 5px;
    transition-property: background-color, scale;
    transition-duration: 0.2s;
}
.howto-dot.on { background-color: var(--accent); border-color: var(--accent); scale: 1.3 1.3; }
.howto-arrow { transition-property: scale, translate; transition-duration: 0.12s; }
.howto-arrow:hover { scale: 1.15 1.15; color: rgb(255, 246, 232); }
.howto-arrow:active { scale: 0.92 0.92; }
.howto-arrow:disabled { opacity: 1; }
.howto-icon.p0 { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconStar01a.png"); }
.howto-icon.p1 { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconHeart01a.png"); }
.howto-icon.p2 { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_BookCover01a.png"); }
/* Notebook: the kit's paper page, tinted, with a dark outline and spine so it reads on the cream page. */
.howto-icon.p3 {
    width: 30px; height: 38px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_BookPageRight01a.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(214, 120, 64);
    border-color: var(--ink);
    border-width: 2px;
    border-left-width: 6px;
    border-top-right-radius: 3px; border-bottom-right-radius: 3px;
}
.howto-icon.p4 { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconCoin01a.png"); }
.howto-icon.p5 { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconTick01a.png"); }
.howto-icon.p6 { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconGear01a.png"); }
.howto-icon.p7 { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconHome01a.png"); }
.howto-icon.p8 { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconPause01a.png"); }

.howto-body .howto-text { min-height: 0; font-size: 19px; }
/* Mode picker fits inside the page (title and Back stay off the book's edges) */
.mode-card { margin: 3px 16px; padding: 4px 14px 8px 14px; flex-shrink: 0; } /* never squash a card: its info line wraps */
.mode-card.recommended { padding-top: 4px; margin-bottom: 6px; }
.mode-card Label { margin: 0; padding: 0; }
.mode-name { font-size: 26px; }
.mode-card.recommended .mode-name { font-size: 30px; }
.mode-info { font-size: 16px; align-self: stretch; } /* full card width, so it wraps onto a second line properly */

/* Mode cards use the pixel button too: on hover (orange) every line turns light so it stays readable */
.mode-card:hover .mode-name, .mode-card:hover .mode-badge, .mode-card:hover .mode-info { color: rgb(255, 246, 232); }
/* ...on the orange "hot" button (the recommended card's own cream background would otherwise stay, hiding the white text). */
.mode-card:hover, .mode-card.recommended:hover { background-image: url("project://database/Assets/Art/UI/PC/T_PC_ButtonHot.png"); }
