/* Shared game UI theme built from the TravelBook Lite kit (pixel art, 4x scale). */
:root {
    --ink: rgb(74, 48, 38);
    --ink-soft: rgb(128, 92, 70);
    --accent: rgb(214, 120, 64);
}

.hidden { display: none; }

.layer {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/FA_Jersey10.asset?fileID=11400000&guid=695e028e43a4c024b8862f8088123e3c&type=2#FA_Jersey10");
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

/* ---------- Hover prompt ---------- */
.prompt {
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding: 6px 14px 8px 10px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Frame01a.png");
    -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 3;
    -unity-slice-scale: 4px;
    transition-property: opacity; transition-duration: 0.12s;
}
.prompt.far { opacity: 0.55; }
.prompt-icon {
    /* Mouse_L1 is 95x120: keep that ratio */
    width: 24px; height: 30px;
    flex-shrink: 0;
    margin-right: 6px;
    background-image: url("project://database/Assets/Art/UI/Mouse_L1.png");
    background-size: contain;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
}
.prompt-label {
    color: var(--ink);
    font-size: 20px;
    -unity-font-style: bold;
}

/* ---------- Inspect bubble ---------- */
.bubble {
    position: absolute;
    max-width: 340px;
    padding: 12px 18px 16px 18px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
}
.bubble-text {
    color: var(--ink);
    font-size: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ---------- Dialogue ---------- */
.dialogue {
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 104px;
}
.dialogue-box {
    width: 70%;
    max-width: 980px;
    min-height: 170px;
    padding: 34px 40px 30px 40px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 6px;
}
.speaker {
    position: absolute;
    top: -26px; left: 34px;
    padding: 6px 18px 10px 18px;
    color: rgb(255, 245, 230);
    font-size: 26px;
    -unity-font-style: bold;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_FrameSelect01a.png");
    -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 3;
    -unity-slice-scale: 4px;
}
.line {
    color: var(--ink);
    font-size: 34px;
    white-space: normal;
}
.continue {
    position: absolute;
    right: 30px; bottom: 22px;
    width: 32px; height: 26px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconArrow01a.png");
    -unity-background-scale-mode: scale-to-fit;
    rotate: 90deg;
}
.choices {
    width: 70%;
    max-width: 980px;
    align-items: flex-end;
    margin-bottom: 12px;
}
.choice {
    min-width: 280px;
    margin: 4px 0;
    padding: 8px 20px 12px 20px;
    border-width: 0;
    color: var(--ink);
    font-size: 27px;
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Frame01a.png");
    -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 3;
    -unity-slice-scale: 4px;
}
.choice:hover {
    color: rgb(255, 245, 230);
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_FrameSelect01a.png");
}

/* Menus (later): Jersey 15 */
.font-title { -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/FA_Jersey15.asset?fileID=11400000&guid=09d0977d6e9c37c46bccdc3269737834&type=2#FA_Jersey15"); }

/* ---------- Shared kit pieces ---------- */
.kit-button {
    padding: 4px 14px 8px 14px;
    margin: 0;
    border-width: 0;
    color: var(--ink);
    font-size: 22px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Frame01a.png");
    -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 3;
    -unity-slice-scale: 4px;
}
.kit-button:hover {
    color: rgb(255, 245, 230);
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_FrameSelect01a.png");
}
.kit-button:disabled { opacity: 0.45; }
.kit-button.wide { align-self: stretch; margin-top: 10px; -unity-text-align: middle-center; }
.icon-coin {
    width: 33px; height: 36px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconCoin01a.png");
}

/* ---------- HUD ---------- */
.hud { justify-content: flex-end; }
.hud-bar {
    position: absolute;
    bottom: 18px;
    align-self: center;
    flex-direction: row;
    align-items: center;
    padding: 6px 24px 10px 24px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
}
.hud-day, .hud-clock, .hud-coins Label { color: var(--ink); font-size: 30px; }
.hud-clock { margin: 0 28px; }
.hud-coins { flex-direction: row; align-items: center; }
.hud-coins Label { margin-left: 8px; }
.hud-carry {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    margin: 0 0 24px 24px;
    padding: 10px 20px 14px 14px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
}
.hud-carry-icon {
    width: 60px; height: 60px; margin-right: 12px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Slot01a.png");
}
.hud-carry-label { color: var(--ink); font-size: 24px; max-width: 360px; white-space: normal; }

/* ---------- Shelf (open book) ---------- */
.modal {
    background-color: rgba(30, 18, 14, 0.45);
    justify-content: center;
    align-items: center;
}
.book-spread {
    width: 896px; height: 640px;
    flex-direction: row;
    padding: 26px 32px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_BookCover01a.png");
}
.page { width: 416px; height: 588px; padding: 36px 34px 30px 34px; }
.page-left { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_BookPageLeft01a.png"); }
.page-right { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_BookPageRight01a.png"); }
.page-title { color: var(--ink); font-size: 34px; margin-bottom: 12px; -unity-text-align: middle-center; }
.shelf-list { flex-grow: 1; }
.shelf-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 0 8px 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(128, 92, 70, 0.35);
}
.shelf-row-text { flex-grow: 1; flex-shrink: 1; margin-right: 8px; }
#row-title { color: var(--ink); font-size: 22px; white-space: normal; }
#row-sub { color: var(--ink-soft); font-size: 17px; white-space: normal; }
.hand-info { align-items: center; flex-grow: 1; justify-content: center; }
.hand-book {
    width: 120px; height: 120px; margin-bottom: 14px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Slot01a.png");
}
.hand-info.empty .hand-book { opacity: 0.4; }
.hand-title { color: var(--ink); font-size: 28px; white-space: normal; -unity-text-align: middle-center; }
.hand-sub { color: var(--ink-soft); font-size: 20px; white-space: normal; -unity-text-align: middle-center; margin-top: 6px; }
.shelf-note { color: rgb(170, 60, 40); font-size: 20px; -unity-text-align: middle-center; min-height: 26px; }
.close-button {
    position: absolute;
    top: -14px; right: -14px;
    width: 56px; height: 56px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconCross01a.png");
}
.close-button:hover { scale: 1.1 1.1; }
.kit-button.small { font-size: 17px; padding: 2px 8px 6px 8px; margin-left: 4px; }

/* ---------- Kit scrollbar (shelf list) ---------- */
.shelf-list .unity-scroll-view__content-container { padding-right: 14px; }
.shelf-list .unity-scroller--vertical {
    width: 18px;
    margin-left: 6px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.shelf-list .unity-scroller__low-button,
.shelf-list .unity-scroller__high-button { display: none; }
.shelf-list .unity-scroller__slider { margin: 0; }
.shelf-list .unity-base-slider__tracker {
    left: 5px; right: 5px; width: auto;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Bar01a.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 1; -unity-slice-bottom: 1;
    -unity-slice-scale: 4px;
}
.shelf-list .unity-base-slider__dragger {
    left: 0; width: 18px; min-height: 40px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Handle03a.png");
    -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 3;
    -unity-slice-scale: 3px;
}
.shelf-list .unity-base-slider__dragger-border { display: none; }
.shelf-list .unity-scroller--horizontal { display: none; }

/* ---------- Customers: speech + patience over their heads ---------- */
.customer-tag { position: absolute; align-items: center; }
.customer-speech {
    max-width: 320px;
    margin-bottom: 6px;
    padding: 10px 16px 14px 16px;
    color: var(--ink);
    font-size: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
}
.patience-bar {
    width: 124px; height: 16px;
    padding: 4px 4px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Bar01a.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 1; -unity-slice-bottom: 1;
    -unity-slice-scale: 4px;
}
.patience-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(120, 200, 100);
    transition-property: width, background-color; transition-duration: 0.2s;
}
.patience-fill.mid { background-color: rgb(240, 190, 70); }
.patience-fill.low { background-color: rgb(225, 85, 65); }

/* ---------- Repair desk ---------- */
.repair-total { color: var(--ink-soft); font-size: 20px; -unity-text-align: middle-center; margin-top: 8px; }
.repair-status, .repair-game { flex-grow: 1; }
.repair-work { flex-grow: 1; }
.work-item { margin-bottom: 12px; }
.work-bar { width: 100%; margin-top: 4px; }
.repair-result { color: var(--ink); font-size: 24px; white-space: normal; -unity-text-align: middle-center; }
.repair-result.perfect { color: rgb(196, 110, 40); }
.rg-hint { color: var(--ink-soft); font-size: 21px; white-space: normal; -unity-text-align: middle-center; margin-bottom: 26px; }
.rg-track {
    height: 44px;
    margin: 0 6px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Bar01a.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 1; -unity-slice-bottom: 1;
    -unity-slice-scale: 6px;
}
.rg-zone { position: absolute; top: 6px; bottom: 6px; background-color: rgba(120, 200, 100, 0.75); }
.rg-fill { position: absolute; left: 0; top: 12px; bottom: 12px; width: 0; background-color: rgb(240, 225, 170); }
.rg-marker {
    position: absolute;
    top: -8px; bottom: -8px;
    width: 10px;
    margin-left: -5px;
    background-color: rgb(196, 110, 40);
    border-width: 2px;
    border-color: rgb(74, 48, 38);
}
.rg-feedback { color: rgb(196, 110, 40); font-size: 34px; -unity-text-align: middle-center; min-height: 52px; margin-top: 18px; }
.rg-action { font-size: 30px; padding: 10px 14px 14px 14px; }
.rg-skip { align-self: center; margin-top: 10px; }

/* ---------- Day report ---------- */
.report-stars { color: rgb(196, 110, 40); font-size: 44px; -unity-text-align: middle-center; letter-spacing: 6px; }
.report-stats { color: var(--ink); font-size: 22px; white-space: pre; margin: 8px 12px; flex-grow: 1; }
.report-rep { color: var(--ink-soft); font-size: 21px; white-space: normal; -unity-text-align: middle-center; }
.plan-tabs { flex-direction: row; justify-content: center; margin-bottom: 4px; }
.plan-tab { margin: 0 4px; font-size: 22px; }
.plan-tab.selected { color: rgb(196, 110, 40); scale: 1.08 1.08; }

/* ---------- HUD polish ---------- */
.hud-banner {
    position: absolute;
    top: 40px;
    align-self: center;
    padding: 10px 28px 14px 28px;
    color: var(--ink);
    font-size: 30px;
    -unity-text-align: middle-center;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
}
.hud-coin-delta { position: absolute; top: -30px; right: 0; color: rgb(120, 200, 100); font-size: 26px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(40, 30, 20); }
.hud-coin-delta.negative { color: rgb(240, 120, 100); }

/* ---------- Customer name plate, VIP, mood face ---------- */
.customer-name {
    color: rgb(250, 240, 220);
    font-size: 18px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(40, 30, 20);
    margin-bottom: 2px;
}
.customer-name.vip {
    color: rgb(74, 48, 38);
    background-color: rgb(240, 196, 80);
    border-width: 2px;
    border-color: rgb(150, 100, 30);
    border-top-left-radius: 8px; border-top-right-radius: 8px;
    border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;
    padding: 0 10px 3px 10px;
    -unity-text-outline-width: 0;
    font-size: 19px;
}
.customer-speech.vip { border-width: 3px; border-color: rgb(220, 170, 60); }

.mood {
    width: 30px; height: 30px;
    border-width: 2px;
    border-color: rgb(74, 48, 38);
    border-top-left-radius: 15px; border-top-right-radius: 15px;
    border-bottom-left-radius: 15px; border-bottom-right-radius: 15px;
    background-color: rgb(250, 214, 96);
}
.mood.ok { background-color: rgb(240, 186, 92); }
.mood.sad { background-color: rgb(232, 128, 96); }
.mood-eye {
    position: absolute; top: 8px;
    width: 4px; height: 5px;
    background-color: rgb(74, 48, 38);
    border-top-left-radius: 2px; border-top-right-radius: 2px;
    border-bottom-left-radius: 2px; border-bottom-right-radius: 2px;
}
.mood-eye.left { left: 7px; }
.mood-eye.right { right: 7px; }
.mood-mouth {
    position: absolute; left: 7px; width: 12px;
    border-color: rgb(74, 48, 38);
}
/* smile */
.mood.happy .mood-mouth { top: 13px; height: 6px; border-bottom-width: 2px; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px; }
/* flat */
.mood.ok .mood-mouth { top: 17px; height: 0; border-top-width: 2px; }
/* frown */
.mood.sad .mood-mouth { top: 16px; height: 6px; border-top-width: 2px; border-top-left-radius: 6px; border-top-right-radius: 6px; }

/* ---------- Stamina meter over the player ---------- */
.stamina {
    position: absolute;
    flex-direction: row; align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}
.stamina.shown { opacity: 1; }
.stamina-icon {
    width: 18px; height: 18px; margin-right: 3px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconEnergy01a.png");
}
.stamina-bar {
    width: 64px; height: 12px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Bar01a.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 1; -unity-slice-bottom: 1;
    -unity-slice-scale: 3px;
    padding: 2px 3px;
}
.stamina-fill { height: 100%; background-color: rgb(250, 214, 96); }
.stamina.tired .stamina-fill { background-color: rgb(232, 112, 90); }
.stamina.tired .stamina-icon { -unity-background-image-tint-color: rgb(232, 112, 90); }

/* Waiting visitor you haven't talked to yet: just a small "?" bubble. */
.customer-speech.ask { font-size: 28px; padding: 2px 14px 8px 14px; -unity-text-align: middle-center; color: var(--accent); }

/* ---------- Pixel-art mood face (replaces the drawn one) ---------- */
.mood {
    width: 26px; height: 26px;
    border-width: 0;
    border-top-left-radius: 0; border-top-right-radius: 0;
    border-bottom-left-radius: 0; border-bottom-right-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/Mood/T_Mood_Happy.png");
    -unity-background-scale-mode: stretch-to-fill;
}
.mood.ok { background-color: rgba(0, 0, 0, 0); background-image: url("project://database/Assets/Art/UI/Mood/T_Mood_Okay.png"); }
.mood.sad { background-color: rgba(0, 0, 0, 0); background-image: url("project://database/Assets/Art/UI/Mood/T_Mood_Sad.png"); }
.mood-eye, .mood-mouth { display: none; }

/* Coin change pop: green when you earn, red when you spend (id selector beats .hud-coins Label). */
#hud-coin-delta {
    color: rgb(110, 215, 95);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(40, 30, 20);
}
#hud-coin-delta.negative { color: rgb(235, 85, 70); }

/* Shelf note wraps inside the page instead of running off it. */
.shelf-note { white-space: normal; max-width: 100%; margin: 0 10px; }
.ready-head { color: var(--accent); margin-top: 14px; }

/* ---------- Day report rows ---------- */
.report-rows { margin: 6px 14px; flex-grow: 1; }
.report-row { flex-direction: row; justify-content: space-between; padding: 2px 4px; border-bottom-width: 1px; border-bottom-color: rgba(128, 92, 70, 0.25); }
.report-key { color: var(--ink-soft); font-size: 20px; }
.report-val { color: var(--ink); font-size: 20px; -unity-text-align: middle-right; }
.report-row.total .report-key, .report-row.total .report-val { color: var(--accent); font-size: 23px; }

/* ---------- Book-page search bar (end-of-day shop) ---------- */
.page-filter-bar { margin: 0 6px 6px 6px; }
.page-filter-bar.hidden { display: none; }
.page-filter-bar .filter-search { margin: 0 0 6px 0; }
.page-filter-bar .filter-search .unity-base-text-field__input {
    background-color: rgba(255, 255, 255, 0.35);
    border-width: 2px; border-color: var(--ink-soft);
    border-top-left-radius: 4px; border-top-right-radius: 4px;
    border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;
    color: var(--ink); font-size: 19px; padding: 2px 8px;
}
.page-filters { flex-direction: row; justify-content: center; }
.page-filter { font-size: 17px; padding: 2px 10px 6px 10px; margin: 0 4px; }

/* ---------- Screen fade between days ---------- */
.screen-fade {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(12, 8, 6);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.55s;
}
.screen-fade.on { opacity: 1; }

/* Shelf rows: Take / Worn / Damaged stacked on the right; title keeps the room. */
.take-col { flex-direction: column; align-items: stretch; flex-shrink: 0; width: 92px; }
.take-col .kit-button { margin: 2px 0; -unity-text-align: middle-center; font-size: 19px; padding: 2px 6px 5px 6px; }
.shelf-row .shelf-row-text { flex-basis: 0; flex-grow: 1; }

/* The report sits on solid black so the night fade doesn't reveal the library behind it. */
#report { background-color: rgb(12, 8, 6); }

/* Opening-day notice pinned under the top of the screen until noon. */
.hud-pin {
    position: absolute; top: 18px; align-self: center;
    padding: 4px 18px 8px 18px;
    color: var(--ink);
    font-size: 22px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
}

/* Same gap from the top as the HUD bar has from the bottom; drops below the pinned notice while it shows. */
.hud-banner { top: 18px; }
.hud-banner.below-pin { top: 70px; }

/* ---------- Audit log rows (Day Report "Log" tab) ---------- */
.log-row { padding: 6px 0 8px 0; border-bottom-width: 2px; border-bottom-color: rgba(128, 92, 70, 0.35); }
.log-head { color: var(--accent); font-size: 18px; }
.log-line { color: var(--ink); font-size: 19px; white-space: normal; }
.log-outcome { color: var(--ink-soft); font-size: 17px; white-space: normal; margin-top: 2px; }
.log-empty { color: var(--ink-soft); font-size: 20px; white-space: normal; -unity-text-align: middle-center; margin-top: 30px; }

/* ---------- Staff calling for help / waiting to report ---------- */
.staff-pointer {
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding: 6px 12px 9px 10px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
}
.staff-pointer-icon {
    width: 32px; height: 32px; margin-right: 6px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Alert01a.png");
    -unity-background-scale-mode: scale-to-fit;
}
#staff-pointer-label { color: rgb(196, 110, 40); font-size: 28px; }
.staff-pointer-arrow {
    width: 22px; height: 22px; margin-left: 6px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconArrow01a.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* Damaged copies on a shelf: red title and a red "Damaged" button */
.shelf-row.has-damage #row-title { color: rgb(184, 50, 42); }
.take-damaged { color: rgb(184, 50, 42); }
/* Repair desk: heading for copies still out in the library */
.repair-section { margin-top: 14px; color: rgb(196, 110, 40); }

/* Request type icons (visitors' prompts and the computer's tiles use the same ones) */
.req-icon { width: 30px; height: 30px; margin-right: 6px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; display: none; }
.req-icon.on { display: flex; }
.req-card { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconHeart01a.png"); }
.req-buy { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconCoin01a.png"); }
.req-read { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_BookCover01a.png"); }
.req-return { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconRestart01a.png"); }
.req-new { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconStar01c.png"); }
.req-rare { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconStar01a.png"); }
.req-collect { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconTick01a.png"); }
.req-settings { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconGear01a.png"); }
.customer-say-row { flex-direction: row; align-items: center; }

/* Popular today on the book pages (shelves, end-of-day shop) */
.popular { border-left-width: 4px; border-left-color: rgb(214, 120, 64); background-color: rgba(235, 200, 120, 0.18);
           transition-property: background-color, border-left-color; transition-duration: 0.8s; }
.popular.glow-on { background-color: rgba(235, 200, 120, 0.45); border-left-color: rgb(235, 160, 90); }
.popular-badge { color: rgb(74, 48, 38); background-color: rgb(235, 200, 120); font-size: 15px; padding: 0 6px 2px 6px; margin-left: 8px;
                 border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; }
.popular-title-row { flex-direction: row; align-items: center; flex-wrap: wrap; }
.page-filters { flex-wrap: wrap; }
.req-read { background-image: none; }

/* Something to do behind this tab (affordable upgrade or hire): warm tint that breathes */
.ready { color: rgb(214, 120, 64); transition-property: -unity-background-image-tint-color; transition-duration: 0.8s; }
.ready.glow-on { -unity-background-image-tint-color: rgb(255, 214, 140); }

/* Reputation (and the Dean's goal) on the HUD bar, with a pop when it changes. */
.hud-rep { flex-direction: row; align-items: center; margin-left: 28px; }
.hud-rep Label { color: var(--ink); font-size: 30px; margin-left: 8px; }
.icon-rep { width: 32px; height: 32px; -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconStar01a.png"); }
#hud-rep-delta { position: absolute; top: -30px; right: 0; font-size: 26px; color: rgb(110, 215, 95);
    -unity-text-outline-width: 1.5px; -unity-text-outline-color: rgb(40, 30, 20); }
#hud-rep-delta.negative { color: rgb(235, 85, 70); }
.hud-rep.goal-met Label { color: rgb(214, 120, 64); }
