/* Shared game UI theme built from the TravelBook Lite kit (pixel art, 4x scale). */
:root {
    --ink: rgb(74, 48, 38);
    --ink-soft: rgb(128, 92, 70);
    --accent: rgb(214, 120, 64);
}

.hidden { display: none; }

.layer {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/FA_Jersey10.asset?fileID=11400000&guid=695e028e43a4c024b8862f8088123e3c&type=2#FA_Jersey10");
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

/* ---------- Hover prompt ---------- */
.prompt {
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding: 6px 14px 8px 10px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Frame01a.png");
    -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 3;
    -unity-slice-scale: 4px;
    transition-property: opacity; transition-duration: 0.12s;
}
.prompt.far { opacity: 0.55; }
.prompt-icon {
    /* Mouse_L1 is 95x120: keep that ratio */
    width: 24px; height: 30px;
    flex-shrink: 0;
    margin-right: 6px;
    background-image: url("project://database/Assets/Art/UI/Mouse_L1.png");
    background-size: contain;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
}
.prompt-label {
    color: var(--ink);
    font-size: 20px;
    -unity-font-style: bold;
}

/* ---------- Inspect bubble ---------- */
.bubble {
    position: absolute;
    max-width: 340px;
    padding: 12px 18px 16px 18px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
}
.bubble-text {
    color: var(--ink);
    font-size: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ---------- Dialogue ---------- */
.dialogue {
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 104px;
}
.dialogue-box {
    width: 70%;
    max-width: 980px;
    min-height: 170px;
    padding: 34px 40px 30px 40px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 6px;
}
.speaker {
    position: absolute;
    top: -26px; left: 34px;
    padding: 6px 18px 10px 18px;
    color: rgb(255, 245, 230);
    font-size: 22px;
    -unity-font-style: bold;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_FrameSelect01a.png");
    -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 3;
    -unity-slice-scale: 4px;
}
.line {
    color: var(--ink);
    font-size: 26px;
    white-space: normal;
}
.continue {
    position: absolute;
    right: 30px; bottom: 22px;
    width: 32px; height: 26px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconArrow01a.png");
    -unity-background-scale-mode: scale-to-fit;
    rotate: 90deg;
}
.choices {
    width: 70%;
    max-width: 980px;
    align-items: flex-end;
    margin-bottom: 12px;
}
.choice {
    min-width: 280px;
    margin: 4px 0;
    padding: 8px 20px 12px 20px;
    border-width: 0;
    color: var(--ink);
    font-size: 22px;
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Frame01a.png");
    -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 3;
    -unity-slice-scale: 4px;
}
.choice:hover {
    color: rgb(255, 245, 230);
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_FrameSelect01a.png");
}

/* Menus (later): Jersey 15 */
.font-title { -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/FA_Jersey15.asset?fileID=11400000&guid=09d0977d6e9c37c46bccdc3269737834&type=2#FA_Jersey15"); }

/* ---------- Shared kit pieces ---------- */
.kit-button {
    padding: 4px 14px 8px 14px;
    margin: 0;
    border-width: 0;
    color: var(--ink);
    font-size: 22px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Frame01a.png");
    -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 3;
    -unity-slice-scale: 4px;
}
.kit-button:hover {
    color: rgb(255, 245, 230);
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_FrameSelect01a.png");
}
.kit-button:disabled { opacity: 0.45; }
.kit-button.wide { align-self: stretch; margin-top: 10px; -unity-text-align: middle-center; }
.icon-coin {
    width: 33px; height: 36px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconCoin01a.png");
}

/* ---------- HUD ---------- */
.hud { justify-content: flex-end; }
.hud-bar {
    position: absolute;
    bottom: 18px;
    align-self: center;
    flex-direction: row;
    align-items: center;
    padding: 6px 24px 10px 24px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
}
.hud-day, .hud-clock, .hud-coins Label { color: var(--ink); font-size: 30px; }
.hud-clock { margin: 0 28px; }
.hud-coins { flex-direction: row; align-items: center; }
.hud-coins Label { margin-left: 8px; }
.hud-carry {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    margin: 0 0 24px 24px;
    padding: 10px 20px 14px 14px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
}
.hud-carry-icon {
    width: 60px; height: 60px; margin-right: 12px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Slot01a.png");
}
.hud-carry-label { color: var(--ink); font-size: 24px; max-width: 360px; white-space: normal; }

/* ---------- Shelf (open book) ---------- */
.modal {
    background-color: rgba(30, 18, 14, 0.45);
    justify-content: center;
    align-items: center;
}
.book-spread {
    width: 896px; height: 640px;
    flex-direction: row;
    padding: 26px 32px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_BookCover01a.png");
}
.page { width: 416px; height: 588px; padding: 36px 34px 30px 34px; }
.page-left { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_BookPageLeft01a.png"); }
.page-right { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_BookPageRight01a.png"); }
.page-title { color: var(--ink); font-size: 34px; margin-bottom: 12px; -unity-text-align: middle-center; }
.shelf-list { flex-grow: 1; }
.shelf-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 0 8px 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(128, 92, 70, 0.35);
}
.shelf-row-text { flex-grow: 1; flex-shrink: 1; margin-right: 8px; }
#row-title { color: var(--ink); font-size: 22px; white-space: normal; }
#row-sub { color: var(--ink-soft); font-size: 17px; white-space: normal; }
.hand-info { align-items: center; flex-grow: 1; justify-content: center; }
.hand-book {
    width: 120px; height: 120px; margin-bottom: 14px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Slot01a.png");
}
.hand-info.empty .hand-book { opacity: 0.4; }
.hand-title { color: var(--ink); font-size: 28px; white-space: normal; -unity-text-align: middle-center; }
.hand-sub { color: var(--ink-soft); font-size: 20px; white-space: normal; -unity-text-align: middle-center; margin-top: 6px; }
.shelf-note { color: rgb(170, 60, 40); font-size: 20px; -unity-text-align: middle-center; min-height: 26px; }
.close-button {
    position: absolute;
    top: -14px; right: -14px;
    width: 56px; height: 56px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconCross01a.png");
}
.close-button:hover { scale: 1.1 1.1; }
.kit-button.small { font-size: 17px; padding: 2px 8px 6px 8px; margin-left: 4px; }

/* ---------- Kit scrollbar (shelf list) ---------- */
.shelf-list .unity-scroll-view__content-container { padding-right: 14px; }
.shelf-list .unity-scroller--vertical {
    width: 18px;
    margin-left: 6px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.shelf-list .unity-scroller__low-button,
.shelf-list .unity-scroller__high-button { display: none; }
.shelf-list .unity-scroller__slider { margin: 0; }
.shelf-list .unity-base-slider__tracker {
    left: 5px; right: 5px; width: auto;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Bar01a.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 1; -unity-slice-bottom: 1;
    -unity-slice-scale: 4px;
}
.shelf-list .unity-base-slider__dragger {
    left: 0; width: 18px; min-height: 40px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Handle03a.png");
    -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 3;
    -unity-slice-scale: 3px;
}
.shelf-list .unity-base-slider__dragger-border { display: none; }
.shelf-list .unity-scroller--horizontal { display: none; }

/* ---------- Customers: speech + patience over their heads ---------- */
.customer-tag { position: absolute; align-items: center; }
.customer-speech {
    max-width: 320px;
    margin-bottom: 6px;
    padding: 10px 16px 14px 16px;
    color: var(--ink);
    font-size: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
}
.patience-bar {
    width: 124px; height: 16px;
    padding: 4px 4px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Bar01a.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 1; -unity-slice-bottom: 1;
    -unity-slice-scale: 4px;
}
.patience-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(120, 200, 100);
    transition-property: width, background-color; transition-duration: 0.2s;
}
.patience-fill.mid { background-color: rgb(240, 190, 70); }
.patience-fill.low { background-color: rgb(225, 85, 65); }

/* ---------- Repair desk ---------- */
.repair-total { color: var(--ink-soft); font-size: 20px; -unity-text-align: middle-center; margin-top: 8px; }
.repair-status, .repair-game { flex-grow: 1; }
.repair-work { flex-grow: 1; }
.work-item { margin-bottom: 12px; }
.work-bar { width: 100%; margin-top: 4px; }
.repair-result { color: var(--ink); font-size: 24px; white-space: normal; -unity-text-align: middle-center; }
.repair-result.perfect { color: rgb(196, 110, 40); }
.rg-hint { color: var(--ink-soft); font-size: 21px; white-space: normal; -unity-text-align: middle-center; margin-bottom: 26px; }
.rg-track {
    height: 44px;
    margin: 0 6px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Bar01a.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 1; -unity-slice-bottom: 1;
    -unity-slice-scale: 6px;
}
.rg-zone { position: absolute; top: 6px; bottom: 6px; background-color: rgba(120, 200, 100, 0.75); }
.rg-fill { position: absolute; left: 0; top: 12px; bottom: 12px; width: 0; background-color: rgb(240, 225, 170); }
.rg-marker {
    position: absolute;
    top: -8px; bottom: -8px;
    width: 10px;
    margin-left: -5px;
    background-color: rgb(196, 110, 40);
    border-width: 2px;
    border-color: rgb(74, 48, 38);
}
.rg-feedback { color: rgb(196, 110, 40); font-size: 34px; -unity-text-align: middle-center; min-height: 52px; margin-top: 18px; }
.rg-action { font-size: 30px; padding: 10px 14px 14px 14px; }
.rg-skip { align-self: center; margin-top: 10px; }

/* ---------- Day report ---------- */
.report-stars { color: rgb(196, 110, 40); font-size: 44px; -unity-text-align: middle-center; letter-spacing: 6px; }
.report-stats { color: var(--ink); font-size: 22px; white-space: pre; margin: 8px 12px; flex-grow: 1; }
.report-rep { color: var(--ink-soft); font-size: 21px; white-space: normal; -unity-text-align: middle-center; }
.plan-tabs { flex-direction: row; justify-content: center; margin-bottom: 4px; }
.plan-tab { margin: 0 4px; font-size: 22px; }
.plan-tab.selected { color: rgb(196, 110, 40); scale: 1.08 1.08; }

/* ---------- HUD polish ---------- */
.hud-banner {
    position: absolute;
    top: 40px;
    align-self: center;
    padding: 10px 28px 14px 28px;
    color: var(--ink);
    font-size: 30px;
    -unity-text-align: middle-center;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
}
.hud-coin-delta { position: absolute; top: -30px; right: 0; color: rgb(120, 200, 100); font-size: 26px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(40, 30, 20); }
.hud-coin-delta.negative { color: rgb(240, 120, 100); }
