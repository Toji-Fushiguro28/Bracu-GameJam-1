/* Shared game UI theme built from the TravelBook Lite kit (pixel art, 4x scale). */
:root {
    --ink: rgb(74, 48, 38);
    --ink-soft: rgb(128, 92, 70);
    --accent: rgb(214, 120, 64);
}

.hidden { display: none; }

.layer {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/FA_Jersey10.asset?fileID=11400000&guid=695e028e43a4c024b8862f8088123e3c&type=2#FA_Jersey10");
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

/* ---------- Hover prompt ---------- */
.prompt {
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding: 6px 14px 8px 10px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Frame01a.png");
    -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 3;
    -unity-slice-scale: 4px;
    transition-property: opacity; transition-duration: 0.12s;
}
.prompt.far { opacity: 0.55; }
.prompt-icon {
    /* Mouse_L1 is 95x120: keep that ratio */
    width: 24px; height: 30px;
    flex-shrink: 0;
    margin-right: 6px;
    background-image: url("project://database/Assets/Art/UI/Mouse_L1.png");
    background-size: contain;
    background-repeat: no-repeat;
    background-position-x: center;
    background-position-y: center;
}
.prompt-label {
    color: var(--ink);
    font-size: 20px;
}

/* ---------- Inspect bubble ---------- */
.bubble {
    position: absolute;
    max-width: 340px;
    padding: 12px 18px 16px 18px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
}
.bubble-text {
    color: var(--ink);
    font-size: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ---------- Dialogue ---------- */
.dialogue {
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 104px;
}
.dialogue-box {
    width: 70%;
    max-width: 980px;
    min-height: 170px;
    padding: 34px 40px 30px 40px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 6px;
}
.speaker {
    position: absolute;
    top: -26px; left: 34px;
    padding: 6px 18px 10px 18px;
    color: rgb(255, 245, 230);
    font-size: 26px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_FrameSelect01a.png");
    -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 3;
    -unity-slice-scale: 4px;
}
.line {
    color: var(--ink);
    font-size: 34px;
    white-space: normal;
}
.continue {
    position: absolute;
    right: 30px; bottom: 22px;
    width: 32px; height: 26px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconArrow01a.png");
    -unity-background-scale-mode: scale-to-fit;
    rotate: 90deg;
}
.choices {
    width: 70%;
    max-width: 980px;
    align-items: flex-end;
    margin-bottom: 12px;
}
/* Dialogue choices: the computer's pixel button */
.choice {
    min-width: 280px;
    margin: 4px 0;
    padding: 8px 20px 12px 20px;
    border-width: 0;
    border-radius: 0;
    color: var(--ink);
    font-size: 27px;
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/PC/T_PC_Button.png");
    -unity-slice-left: 1; -unity-slice-right: 1; -unity-slice-top: 2; -unity-slice-bottom: 3;
    -unity-slice-scale: 3px;
}
.choice:hover {
    color: rgb(255, 246, 232);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/PC/T_PC_ButtonHot.png");
}
.choice:active { translate: 0 2px; }

/* Menus (later): Jersey 15 */
.font-title { -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/FA_Jersey15.asset?fileID=11400000&guid=09d0977d6e9c37c46bccdc3269737834&type=2#FA_Jersey15"); }

/* ---------- Shared kit pieces ---------- */
/* Every button uses the computer's pixel button (Art/UI/PC): cream with a dark outline and a bevel,
   orange on hover, a flat greyed one when disabled (solid, never see-through). */
.kit-button {
    padding: 6px 14px 10px 14px;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    color: rgb(59, 42, 29);
    font-size: 22px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/PC/T_PC_Button.png");
    -unity-slice-left: 1; -unity-slice-right: 1; -unity-slice-top: 2; -unity-slice-bottom: 3;
    -unity-slice-scale: 3px;
}
.kit-button:hover {
    color: rgb(255, 246, 232);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/PC/T_PC_ButtonHot.png");
}
.kit-button:active { translate: 0 2px; }
.kit-button:disabled, .kit-button:disabled:hover {
    opacity: 1;
    color: rgb(127, 106, 72);
    translate: 0 0;
    background-image: url("project://database/Assets/Art/UI/PC/T_PC_ButtonOff.png");
}
.kit-button.wide { align-self: stretch; margin-top: 10px; -unity-text-align: middle-center; }
.icon-coin {
    width: 33px; height: 36px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconCoin01a.png");
}

/* ---------- HUD ---------- */
.hud { justify-content: flex-end; }
.hud-bar {
    position: absolute;
    bottom: 18px;
    align-self: center;
    flex-direction: row;
    align-items: center;
    padding: 6px 24px 10px 24px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
}
.hud-day, .hud-clock, .hud-coins Label { color: var(--ink); font-size: 30px; }
.hud-clock { margin: 0 28px; }
.hud-coins { flex-direction: row; align-items: center; }
.hud-coins Label { margin-left: 8px; }
.hud-carry {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    margin: 0 0 24px 24px;
    padding: 10px 20px 14px 14px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
}
.hud-carry-icon {
    width: 60px; height: 60px; margin-right: 12px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Slot01a.png");
}
.hud-carry-label { color: var(--ink); font-size: 24px; max-width: 360px; white-space: normal; }

/* ---------- Shelf (open book) ---------- */
.modal {
    background-color: rgba(30, 18, 14, 0.45);
    justify-content: center;
    align-items: center;
}
.book-spread {
    width: 896px; height: 640px;
    flex-direction: row;
    padding: 26px 32px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_BookCover01a.png");
}
.page { width: 416px; height: 588px; padding: 36px 34px 30px 34px; }
.page-left { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_BookPageLeft01a.png"); }
.page-right { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_BookPageRight01a.png"); }
.page-title { color: var(--ink); font-size: 34px; margin-bottom: 12px; -unity-text-align: middle-center; }
.shelf-list { flex-grow: 1; }
.shelf-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 0 8px 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(128, 92, 70, 0.35);
}
.shelf-row-text { flex-grow: 1; flex-shrink: 1; margin-right: 8px; }
#row-title { color: var(--ink); font-size: 22px; white-space: normal; }
#row-sub { color: var(--ink-soft); font-size: 17px; white-space: normal; }
.hand-info { align-items: center; flex-grow: 1; justify-content: center; }
.hand-book {
    width: 120px; height: 120px; margin-bottom: 14px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Slot01a.png");
}
.hand-info.empty .hand-book { opacity: 0.4; }
.hand-title { color: var(--ink); font-size: 28px; white-space: normal; -unity-text-align: middle-center; }
.hand-sub { color: var(--ink-soft); font-size: 20px; white-space: normal; -unity-text-align: middle-center; margin-top: 6px; }
.shelf-note { color: rgb(170, 60, 40); font-size: 20px; -unity-text-align: middle-center; min-height: 26px; }
.close-button {
    position: absolute;
    top: -14px; right: -14px;
    width: 56px; height: 56px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconCross01a.png");
}
.close-button:hover { scale: 1.1 1.1; }
.kit-button.small { font-size: 17px; padding: 4px 8px 6px 8px; margin-left: 4px; -unity-slice-scale: 2px; }

/* ---------- Kit scrollbar (shelf list) ---------- */
.shelf-list .unity-scroll-view__content-container { padding-right: 14px; }
.shelf-list .unity-scroller--vertical {
    width: 18px;
    margin-left: 6px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.shelf-list .unity-scroller__low-button,
.shelf-list .unity-scroller__high-button { display: none; }
.shelf-list .unity-scroller__slider { margin: 0; }
.shelf-list .unity-base-slider__tracker {
    left: 5px; right: 5px; width: auto;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Bar01a.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 1; -unity-slice-bottom: 1;
    -unity-slice-scale: 4px;
}
.shelf-list .unity-base-slider__dragger {
    left: 0; width: 18px; min-height: 40px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Handle03a.png");
    -unity-slice-left: 3; -unity-slice-right: 3; -unity-slice-top: 3; -unity-slice-bottom: 3;
    -unity-slice-scale: 3px;
}
.shelf-list .unity-base-slider__dragger-border { display: none; }
.shelf-list .unity-scroller--horizontal { display: none; }

/* ---------- Customers: speech + patience over their heads ---------- */
.customer-tag { position: absolute; align-items: center; }
.customer-speech {
    max-width: 320px;
    flex-shrink: 0; /* beside the request icon: wrap inside its own width rather than get squeezed */
    margin-bottom: 6px;
    padding: 10px 16px 14px 16px;
    color: var(--ink);
    font-size: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
}
.patience-bar {
    width: 124px; height: 16px;
    padding: 4px 4px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Bar01a.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 1; -unity-slice-bottom: 1;
    -unity-slice-scale: 4px;
}
.patience-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(120, 200, 100);
    transition-property: width, background-color; transition-duration: 0.2s;
}
.patience-fill.mid { background-color: rgb(240, 190, 70); }
.patience-fill.low { background-color: rgb(225, 85, 65); }

/* ---------- Repair desk ---------- */
.repair-total { color: var(--ink-soft); font-size: 20px; -unity-text-align: middle-center; margin-top: 8px; }
.repair-status, .repair-game { flex-grow: 1; }
.repair-work { flex-grow: 1; }
.work-item { margin-bottom: 12px; }
.work-bar { width: 100%; margin-top: 4px; }
.repair-result { color: var(--ink); font-size: 24px; white-space: normal; -unity-text-align: middle-center; }
.repair-result.perfect { color: rgb(196, 110, 40); }
.rg-hint { color: var(--ink-soft); font-size: 21px; white-space: normal; -unity-text-align: middle-center; margin-bottom: 26px; }
.rg-track {
    height: 44px;
    margin: 0 6px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Bar01a.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 1; -unity-slice-bottom: 1;
    -unity-slice-scale: 6px;
}
.rg-zone { position: absolute; top: 6px; bottom: 6px; background-color: rgba(120, 200, 100, 0.75); }
.rg-fill { position: absolute; left: 0; top: 12px; bottom: 12px; width: 0; background-color: rgb(240, 225, 170); }
.rg-marker {
    position: absolute;
    top: -8px; bottom: -8px;
    width: 10px;
    margin-left: -5px;
    background-color: rgb(196, 110, 40);
    border-width: 2px;
    border-color: rgb(74, 48, 38);
}
.rg-feedback { color: rgb(196, 110, 40); font-size: 34px; -unity-text-align: middle-center; min-height: 52px; margin-top: 18px; }
.rg-action { font-size: 30px; padding: 10px 14px 14px 14px; }
.rg-skip { align-self: center; margin-top: 10px; }

/* ---------- Day report ---------- */
.report-stars { color: rgb(196, 110, 40); font-size: 44px; -unity-text-align: middle-center; letter-spacing: 6px; }
.report-stats { color: var(--ink); font-size: 22px; white-space: pre; margin: 8px 12px; flex-grow: 1; }
.report-rep { color: var(--ink-soft); font-size: 21px; white-space: normal; -unity-text-align: middle-center; }
.plan-tabs { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-bottom: 4px; }
.plan-tab { margin: 0 4px; font-size: 22px; }
.plan-tab.selected { color: rgb(255, 246, 232); background-image: url("project://database/Assets/Art/UI/PC/T_PC_ButtonHot.png"); translate: 0 2px; }

/* ---------- HUD polish ---------- */
.hud-banner {
    position: absolute;
    top: 40px;
    align-self: center;
    padding: 10px 28px 14px 28px;
    color: var(--ink);
    font-size: 30px;
    -unity-text-align: middle-center;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
}
.hud-coin-delta { position: absolute; top: -30px; right: 0; color: rgb(120, 200, 100); font-size: 26px; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(40, 30, 20); }
.hud-coin-delta.negative { color: rgb(240, 120, 100); }

/* ---------- Customer name plate, VIP, mood face ---------- */
.customer-name {
    color: rgb(250, 240, 220);
    font-size: 18px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(40, 30, 20);
    margin-bottom: 2px;
}
.customer-name.vip {
    color: rgb(74, 48, 38);
    background-color: rgb(240, 196, 80);
    border-width: 2px;
    border-color: rgb(150, 100, 30);
    border-top-left-radius: 8px; border-top-right-radius: 8px;
    border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;
    padding: 0 10px 3px 10px;
    -unity-text-outline-width: 0;
    font-size: 19px;
}
.customer-speech.vip { border-width: 3px; border-color: rgb(220, 170, 60); }

.mood {
    width: 30px; height: 30px;
    border-width: 2px;
    border-color: rgb(74, 48, 38);
    border-top-left-radius: 15px; border-top-right-radius: 15px;
    border-bottom-left-radius: 15px; border-bottom-right-radius: 15px;
    background-color: rgb(250, 214, 96);
}
.mood.ok { background-color: rgb(240, 186, 92); }
.mood.sad { background-color: rgb(232, 128, 96); }
.mood-eye {
    position: absolute; top: 8px;
    width: 4px; height: 5px;
    background-color: rgb(74, 48, 38);
    border-top-left-radius: 2px; border-top-right-radius: 2px;
    border-bottom-left-radius: 2px; border-bottom-right-radius: 2px;
}
.mood-eye.left { left: 7px; }
.mood-eye.right { right: 7px; }
.mood-mouth {
    position: absolute; left: 7px; width: 12px;
    border-color: rgb(74, 48, 38);
}
/* smile */
.mood.happy .mood-mouth { top: 13px; height: 6px; border-bottom-width: 2px; border-bottom-left-radius: 6px; border-bottom-right-radius: 6px; }
/* flat */
.mood.ok .mood-mouth { top: 17px; height: 0; border-top-width: 2px; }
/* frown */
.mood.sad .mood-mouth { top: 16px; height: 6px; border-top-width: 2px; border-top-left-radius: 6px; border-top-right-radius: 6px; }

/* ---------- Stamina meter over the player ---------- */
.stamina {
    position: absolute;
    flex-direction: row; align-items: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}
.stamina.shown { opacity: 1; }
.stamina-icon {
    width: 18px; height: 18px; margin-right: 3px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconEnergy01a.png");
}
.stamina-bar {
    width: 64px; height: 12px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Bar01a.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 1; -unity-slice-bottom: 1;
    -unity-slice-scale: 3px;
    padding: 2px 3px;
}
.stamina-fill { height: 100%; background-color: rgb(250, 214, 96); }
.stamina.tired .stamina-fill { background-color: rgb(232, 112, 90); }
.stamina.tired .stamina-icon { -unity-background-image-tint-color: rgb(232, 112, 90); }

/* Waiting visitor you haven't talked to yet: just a small "?" bubble. */
/* "Got something to say": the pixel question mark (Art/UI/PC/T_IconAsk.png, 12x16 drawn 4x) instead of a text bubble. */
.customer-speech.ask {
    width: 48px; height: 64px; max-width: none; padding: 0; margin-bottom: 8px;
    background-image: url("project://database/Assets/Art/UI/PC/T_IconAsk.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-slice-left: 0; -unity-slice-right: 0; -unity-slice-top: 0; -unity-slice-bottom: 0;
}

/* ---------- Pixel-art mood face (replaces the drawn one) ---------- */
.mood {
    width: 26px; height: 26px;
    border-width: 0;
    border-top-left-radius: 0; border-top-right-radius: 0;
    border-bottom-left-radius: 0; border-bottom-right-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/Mood/T_Mood_Happy.png");
    -unity-background-scale-mode: stretch-to-fill;
}
.mood.ok { background-color: rgba(0, 0, 0, 0); background-image: url("project://database/Assets/Art/UI/Mood/T_Mood_Okay.png"); }
.mood.sad { background-color: rgba(0, 0, 0, 0); background-image: url("project://database/Assets/Art/UI/Mood/T_Mood_Sad.png"); }
.mood-eye, .mood-mouth { display: none; }

/* Coin change pop: green when you earn, red when you spend (id selector beats .hud-coins Label). */
#hud-coin-delta {
    color: rgb(110, 215, 95);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(40, 30, 20);
}
#hud-coin-delta.negative { color: rgb(235, 85, 70); }

/* Shelf note wraps inside the page instead of running off it. */
.shelf-note { white-space: normal; max-width: 100%; margin: 0 10px; }
.ready-head { color: var(--accent); margin-top: 14px; }

/* ---------- Day report rows ---------- */
.report-rows { margin: 6px 14px; flex-grow: 1; }
.report-row { flex-direction: row; justify-content: space-between; padding: 2px 4px; border-bottom-width: 1px; border-bottom-color: rgba(128, 92, 70, 0.25); }
.report-key { color: var(--ink-soft); font-size: 20px; }
.report-val { color: var(--ink); font-size: 20px; -unity-text-align: middle-right; }
.report-row.total .report-key, .report-row.total .report-val { color: var(--accent); font-size: 23px; }

/* ---------- Book-page search bar (end-of-day shop) ---------- */
.page-filter-bar { margin: 0 6px 6px 6px; }
.page-filter-bar.hidden { display: none; }
.page-filter-bar .filter-search { margin: 0 0 6px 0; }
.page-filter-bar .filter-search .unity-base-text-field__input {
    background-color: rgba(255, 255, 255, 0.35);
    border-width: 2px; border-color: var(--ink-soft);
    border-top-left-radius: 4px; border-top-right-radius: 4px;
    border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;
    color: var(--ink); font-size: 19px; padding: 2px 8px;
}
.page-filters { flex-direction: row; justify-content: center; }
.page-filter { font-size: 17px; padding: 2px 10px 6px 10px; margin: 0 4px; }

/* ---------- Screen fade between days ---------- */
.screen-fade {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(12, 8, 6);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.55s;
}
.screen-fade.on { opacity: 1; }

/* Shelf rows: Take / Worn / Damaged stacked on the right; title keeps the room. */
.take-col { flex-direction: column; align-items: stretch; flex-shrink: 0; width: 92px; }
.take-col .kit-button { margin: 2px 0; -unity-text-align: middle-center; font-size: 19px; padding: 4px 6px 6px 6px; -unity-slice-scale: 2px; }
.shelf-row .shelf-row-text { flex-basis: 0; flex-grow: 1; }

/* The report sits on solid black so the night fade doesn't reveal the library behind it. */
#report { background-color: rgb(12, 8, 6); }

/* Opening-day notice pinned under the top of the screen until noon. */
.hud-pin {
    position: absolute; top: 18px; align-self: center;
    padding: 4px 18px 8px 18px;
    color: var(--ink);
    font-size: 22px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
}

/* Same gap from the top as the HUD bar has from the bottom; drops below the pinned notice while it shows. */
.hud-banner { top: 18px; }
.hud-banner.below-pin { top: 70px; }

/* ---------- Audit log rows (Day Report "Log" tab) ---------- */
.log-row { padding: 6px 0 8px 0; border-bottom-width: 2px; border-bottom-color: rgba(128, 92, 70, 0.35); }
.log-head { color: var(--accent); font-size: 18px; white-space: normal; }
.log-line { color: var(--ink); font-size: 19px; white-space: normal; }
.log-outcome { color: var(--ink-soft); font-size: 17px; white-space: normal; margin-top: 2px; }
.log-empty { color: var(--ink-soft); font-size: 20px; white-space: normal; -unity-text-align: middle-center; margin-top: 30px; }

/* ---------- Staff calling for help / waiting to report ---------- */
.staff-pointer {
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding: 6px 12px 9px 10px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
}
.staff-pointer-icon {
    width: 32px; height: 32px; margin-right: 6px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Alert01a.png");
    -unity-background-scale-mode: scale-to-fit;
}
#staff-pointer-label { color: rgb(196, 110, 40); font-size: 28px; }
.staff-pointer-arrow {
    width: 22px; height: 22px; margin-left: 6px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconArrow01a.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* Damaged copies on a shelf: red title and a red "Damaged" button */
.shelf-row.has-damage #row-title { color: rgb(184, 50, 42); }
.take-damaged { color: rgb(184, 50, 42); }
/* Repair desk: heading for copies still out in the library */
.repair-section { margin-top: 14px; color: rgb(196, 110, 40); }

/* Request type icons (visitors' prompts and the computer's tiles use the same ones) */
.req-icon { width: 30px; height: 30px; margin-right: 6px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; display: none; }
.req-icon.on { display: flex; }
.req-card { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconHeart01a.png"); }
.req-buy { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconCoin01a.png"); }
.req-read { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_BookCover01a.png"); }
.req-return { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconRestart01a.png"); }
.req-new { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconStar01c.png"); }
.req-rare { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconStar01a.png"); }
.req-collect { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconTick01a.png"); }
.req-settings { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconGear01a.png"); }
.customer-say-row { flex-direction: row; align-items: center; }

/* Popular today on the book pages (shelves, end-of-day shop) */
.popular { border-left-width: 4px; border-left-color: rgb(214, 120, 64); background-color: rgba(235, 200, 120, 0.18);
           transition-property: background-color, border-left-color; transition-duration: 0.8s; }
.popular.glow-on { background-color: rgba(235, 200, 120, 0.45); border-left-color: rgb(235, 160, 90); }
.popular-badge { color: rgb(74, 48, 38); background-color: rgb(235, 200, 120); font-size: 15px; padding: 0 6px 2px 6px; margin-left: 8px;
                 border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; }
.popular-title-row { flex-direction: row; align-items: center; flex-wrap: wrap; }
.page-filters { flex-wrap: wrap; }
.req-read { background-image: none; }

/* Something to do behind this tab (affordable upgrade or hire): warm tint that breathes */
.ready { color: rgb(214, 120, 64); transition-property: -unity-background-image-tint-color; transition-duration: 0.8s; }
.ready.glow-on { -unity-background-image-tint-color: rgb(255, 214, 140); }

/* Reputation (and the Dean's goal) on the HUD bar, with a pop when it changes. */
.hud-rep { flex-direction: row; align-items: center; margin-left: 28px; }
.hud-rep Label { color: var(--ink); font-size: 30px; margin-left: 8px; }
.icon-rep { width: 32px; height: 32px; -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconStar01a.png"); }
#hud-rep-delta { position: absolute; top: -30px; right: 0; font-size: 26px; color: rgb(110, 215, 95);
    -unity-text-outline-width: 1.5px; -unity-text-outline-color: rgb(40, 30, 20); }
#hud-rep-delta.negative { color: rgb(235, 85, 70); }
.hud-rep.goal-met Label { color: rgb(214, 120, 64); }

/* ---------- Coins: their own purse in the top right, with a shake, flying coins and a "+12" when you're paid ---------- */
.hud-purse {
    position: absolute;
    top: 18px; right: 24px;
    padding: 8px 22px 12px 18px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
    transform-origin: center;
}
.hud-purse .icon-coin { width: 44px; height: 48px; }
.hud-purse Label { color: var(--ink); font-size: 40px; margin-left: 10px; min-width: 60px; }
/* A coin flying up into the purse. */
.coin-fly {
    position: absolute;
    width: 26px; height: 28px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconCoin01a.png");
}
/* The "+12" / "-40" that floats up beside the purse. */
.hud Label.coin-pop {
    position: absolute;
    font-size: 72px;
    color: rgb(110, 215, 95);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(40, 30, 20);
}
.hud Label.coin-pop.negative { color: rgb(235, 85, 70); }

/* ---------- Clearer patience: a bigger face, a draining bar beside it, and an angry face when they storm out ---------- */
.mood { width: 34px; height: 34px; overflow: visible; }
.mood-bar {
    position: absolute;
    left: 40px; top: 12px;
    width: 46px; height: 9px;
    background-color: rgba(40, 30, 20, 0.7);
    border-width: 1px; border-color: rgb(40, 30, 20);
    border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;
    overflow: hidden;
}
.mood-bar-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 100%; background-color: rgb(120, 200, 90); }
.mood-bar-fill.ok { background-color: rgb(240, 186, 92); }
.mood-bar-fill.sad { background-color: rgb(225, 80, 60); }
.mood.angry { -unity-background-image-tint-color: rgb(255, 110, 90); }
.customer-speech.angry { color: rgb(200, 45, 35); }

/* A reward for doing something well, rising from where it happened. */
.hud Label.skill-pop {
    position: absolute;
    font-size: 40px;
    color: rgb(255, 214, 110);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(40, 30, 20);
    white-space: nowrap;
}

/* ---------- Day Report: Summary tab (income by source, what went wrong, a tip for tomorrow) ---------- */
.plan-tab { margin: 0 3px; font-size: 20px; }
.summary-head { color: var(--accent); font-size: 23px; margin: 12px 4px 4px 4px; }
.summary-note { color: var(--ink); font-size: 20px; white-space: normal; margin: 2px 6px; }
.summary-note.bad { color: rgb(190, 70, 50); }
.summary-tip { color: var(--ink); font-size: 21px; white-space: normal; margin: 4px 6px; padding: 8px 10px; background-color: rgba(235, 200, 120, 0.35); }

/* ---------- Tutorial card and first-time tips (left side) ---------- */
.tut-card {
    position: absolute;
    left: 24px; top: 110px;
    width: 420px;
    padding: 14px 20px 16px 20px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 4px;
}
.tut-title { color: rgb(196, 110, 40); font-size: 20px; margin-bottom: 4px; }
.tut-text { color: var(--ink); font-size: 23px; white-space: normal; }
.tut-buttons { flex-direction: row; justify-content: flex-end; margin-top: 10px; }
.tut-button { font-size: 18px; margin-left: 8px; }

/* A staff member did something: a short line on the left, a little above the middle. */
.hud Label.staff-note {
    position: absolute;
    left: 24px;
    top: 36%;
    padding: 4px 14px 7px 12px;
    font-size: 22px;
    color: var(--ink);
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4;
    -unity-slice-scale: 3px;
    white-space: nowrap;
}

/* Shelf: what the picked book is about. */
.shelf-about { color: var(--ink); font-size: 19px; white-space: normal; margin: 6px 14px 4px 14px; -unity-text-align: upper-left; }
.shelf-row.picked { background-color: rgba(214, 120, 64, 0.18); }

/* The edge arrow to a visitor waiting with a "?": the same pixel question mark. */
#staff-pointer-label.ask {
    width: 30px; height: 40px; padding: 0;
    background-image: url("project://database/Assets/Art/UI/PC/T_IconAsk.png");
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 0; -unity-slice-right: 0; -unity-slice-top: 0; -unity-slice-bottom: 0;
}

/* ---------- Shelf book (overhaul): book rows, hands as slots, back cover ---------- */
/* Rows: a spine strip on the left (gold Epic, purple Legendary), then title / author + subject / copies, price, orders. */
.shelf-row.book-spine { border-left-width: 5px; border-left-color: rgba(128, 92, 70, 0.35); padding-left: 8px; }
.shelf-row.book-spine.epic { border-left-color: rgb(61, 52, 139); }
.shelf-row.book-spine.legendary { border-left-color: rgb(95, 15, 64); }
.row-tag { align-self: flex-start; color: rgb(184, 50, 42); font-size: 15px; padding: 0 6px 2px 6px; margin: 2px 0; border-width: 2px; border-color: rgb(184, 50, 42); }
.row-meta { flex-direction: row; align-items: center; margin-top: 3px; }
.row-pips { flex-direction: row; align-items: center; margin-right: 6px; }
.cpip { width: 13px; height: 13px; margin-right: 3px; border-width: 2px; border-color: rgb(73, 51, 51); background-color: rgb(98, 168, 84); }
.cpip.worn { background-color: rgb(225, 196, 50); }
.cpip.damaged { background-color: rgb(212, 62, 62); }
.row-meta-text { color: var(--ink-soft); font-size: 16px; margin: 0 10px 0 0; padding: 0; }
.row-meta-text.bad { color: rgb(184, 50, 42); }
.row-coin, .row-lock, .row-clock { width: 18px; height: 18px; margin-right: 4px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.row-coin { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconCoin01a.png"); width: 16px; }
.row-lock { background-image: url("project://database/Assets/Art/UI/PC/T_IconKey.png"); }
.row-clock { background-image: url("project://database/Assets/Art/UI/PC/T_IconClock.png"); }

/* Hands: one slot per book you can carry. */
.hand-info { flex-grow: 0; margin-top: 4px; }
.hand-slots { flex-direction: row; justify-content: center; margin-bottom: 8px; }
.hand-slot {
    width: 74px; height: 74px; margin: 0 4px; align-items: center; justify-content: center;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Slot01a.png");
}
.hand-slot-book, .carry-book { width: 42px; height: 42px; -unity-background-scale-mode: scale-to-fit; background-image: url("project://database/Assets/Art/UI/PC/T_IconBook.png"); }
.hand-slot-book.worn, .carry-book.worn { background-image: url("project://database/Assets/Art/UI/PC/T_IconBookWorn.png"); }
.hand-slot-book.damaged, .carry-book.damaged { background-image: url("project://database/Assets/Art/UI/PC/T_IconBookDamaged.png"); }
.hand-slot-book.empty { opacity: 0.1; }
.hand-title { font-size: 24px; }
.hand-sub { font-size: 17px; margin-top: 2px; }

/* The back cover of the book you clicked. */
.about-box { flex-grow: 1; margin: 10px 4px 6px 4px; padding: 8px 10px 10px 10px; background-color: rgba(207, 176, 113, 0.25); border-width: 2px; border-color: rgba(128, 92, 70, 0.55); }
.about-head { flex-direction: row; align-items: center; margin-bottom: 4px; }
.about-icon { width: 24px; height: 24px; margin-right: 8px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; background-image: url("project://database/Assets/Art/UI/PC/T_IconScroll.png"); }
.about-title { color: var(--accent); font-size: 20px; white-space: normal; flex-shrink: 1; margin: 0; padding: 0; }
.shelf-about { margin: 0 0 6px 0; }
.shelf-about.dim { color: var(--ink-soft); }
.about-tags { flex-direction: row; flex-wrap: wrap; }
.about-chip { font-size: 15px; color: var(--ink-soft); margin: 0 5px 5px 0; padding: 1px 6px 3px 6px; border-width: 2px; border-color: rgba(128, 92, 70, 0.55); }
.about-chip.epic { color: rgb(61, 52, 139); border-color: rgb(61, 52, 139); }
.about-chip.legendary { color: rgb(95, 15, 64); border-color: rgb(95, 15, 64); }
.about-chip.warn { color: rgb(184, 50, 42); border-color: rgb(184, 50, 42); }

/* HUD: the book in your hands, inside its slot. */
.hud-carry-icon { align-items: center; justify-content: center; }
.carry-book { width: 34px; height: 34px; }

/* Hands: each slot with the book's name under it (up to 4). */
.hand-slots { align-items: flex-start; }
.hand-cell { width: 80px; align-items: center; margin: 0 2px; }
.hand-slot { margin: 0 0 4px 0; }
.hand-slot-name { color: var(--ink); font-size: 15px; white-space: normal; -unity-text-align: upper-center; margin: 0; padding: 0; max-width: 80px; }
/* HUD: one row per book you're carrying: the slot, its name on the right. */
.hud-carry-books { flex-direction: column; align-items: flex-start; }
.hud-carry-cell { flex-direction: row; align-items: center; margin: 2px 0; }
.hud-carry-cell .hud-carry-icon { width: 52px; height: 52px; margin: 0 12px 0 0; }
.hud-carry-name { color: var(--ink); font-size: 24px; white-space: normal; -unity-text-align: middle-left; margin: 0; padding: 0; max-width: 340px; }
/* On the notebook's panel: bottom left, as before. */
.hud-carry.carry-float { position: absolute; left: 0; bottom: 0; }

/* ---------- Notification feed (top-left): newest on top, icon + short text ---------- */
.hud-feed { position: absolute; left: 20px; top: 20px; width: 460px; flex-direction: column; align-items: flex-start; }
.feed-card {
    flex-direction: row; align-items: center; max-width: 460px; margin-bottom: 6px; padding: 6px 14px 9px 10px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4; -unity-slice-scale: 3px;
    opacity: 0; translate: -24px 0;
    transition-property: opacity, translate; transition-duration: 0.25s;
}
.feed-card.in { opacity: 1; translate: 0 0; }
.feed-card.urgent { border-left-width: 5px; border-left-color: var(--accent); }
.feed-icon { width: 28px; height: 28px; margin-right: 10px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.feed-text { color: var(--ink); font-size: 21px; white-space: normal; flex-shrink: 1; margin: 0; padding: 0; }
.nf-clock { background-image: url("project://database/Assets/Art/UI/PC/T_IconClock.png"); }
.nf-coin { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconCoin01a.png"); }
.nf-key { background-image: url("project://database/Assets/Art/UI/PC/T_IconKey.png"); }
.nf-star { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconStar01a.png"); }
.nf-books { background-image: url("project://database/Assets/Art/UI/PC/T_IconBooks.png"); }
.nf-broom { background-image: url("project://database/Assets/Art/UI/PC/T_IconBroom.png"); }
.nf-hammer { background-image: url("project://database/Assets/Art/UI/PC/T_IconHammer.png"); }
.nf-news { background-image: url("project://database/Assets/Art/UI/PC/T_IconScroll.png"); }

/* Tips in the feed: lamp icon, gold edge, a small TIP heading; they stay until clicked. */
.feed-card.tip { border-left-width: 5px; border-left-color: rgb(225, 196, 50); }
.feed-col { flex-shrink: 1; }
.feed-tip-head { color: var(--accent); font-size: 16px; letter-spacing: 1px; margin: 0 0 2px 0; padding: 0; }
.nf-tip { background-image: url("project://database/Assets/Art/UI/PC/T_IconLamp.png"); }

/* Patience: one pixel bar in the mood faces' style: dark-brown outline, flat fill with a light top edge and a
   darker bottom edge; green, then the faces' yellow, then red. Drains in tenths (Customer.SetMood). */
.mood-bar { flex-direction: row; overflow: hidden; width: 48px; height: 12px;
    background-color: rgb(58, 40, 32); border-width: 2px; border-color: rgb(74, 48, 38);
    border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.mood-bar-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: rgb(120, 200, 90);
    border-top-width: 2px; border-top-color: rgb(180, 235, 150); border-bottom-width: 2px; border-bottom-color: rgb(80, 150, 60); }
.mood-bar.ok .mood-bar-fill { background-color: rgb(250, 214, 96); border-top-color: rgb(255, 240, 170); border-bottom-color: rgb(205, 160, 60); }
.mood-bar.sad .mood-bar-fill { background-color: rgb(232, 128, 96); border-top-color: rgb(245, 175, 150); border-bottom-color: rgb(185, 80, 60); }

/* ---------- Tutorial: animated pixel frame (UI_TravelBook_SlotCursor01a, 4 frames), its label, the checklist ---------- */
.tut-spot {
    position: absolute;
    -unity-slice-left: 6; -unity-slice-right: 6; -unity-slice-top: 6; -unity-slice-bottom: 6; -unity-slice-scale: 5px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites%20Animated/UI_TravelBook_SlotCursor01a_1.png");
}
.tut-spot.f2 { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites%20Animated/UI_TravelBook_SlotCursor01a_2.png"); }
.tut-spot.f3 { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites%20Animated/UI_TravelBook_SlotCursor01a_3.png"); }
.tut-spot.f4 { background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites%20Animated/UI_TravelBook_SlotCursor01a_4.png"); }
.tut-spot-label {
    position: absolute; max-width: 380px; padding: 6px 12px 9px 12px;
    color: var(--ink); font-size: 20px; white-space: normal; -unity-text-align: middle-center;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Popup01a.png");
    -unity-slice-left: 4; -unity-slice-right: 4; -unity-slice-top: 4; -unity-slice-bottom: 4; -unity-slice-scale: 3px;
}
.tut-checklist { margin: 6px 0 4px 0; }
/* A pixel box on the left of each line; ticked when done. */
.tut-check { color: var(--ink-soft); font-size: 18px; margin: 2px 0; padding: 0 0 0 28px; min-height: 22px;
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_Slot01a.png");
    background-size: 20px 20px; background-repeat: no-repeat no-repeat; background-position-x: left 0; background-position-y: center; }
.tut-check.done { color: rgb(79, 107, 58);
    background-image: url("project://database/Assets/Art/UI/01_TravelBookLite/Sprites/UI_TravelBook_IconTick01a.png"); }
