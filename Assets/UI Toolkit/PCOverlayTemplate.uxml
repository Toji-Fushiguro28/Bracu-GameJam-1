<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="PC.uss" />
    <ui:VisualElement name="container">
        <ui:VisualElement name="menu-window" class="pc-window">
            <ui:VisualElement class="pc-header">
                <ui:Label name="welcome-label" text="WHITMORE OS" class="pc-title font-title" />
                <ui:Label text="front desk terminal" class="pc-subtitle" />
            </ui:VisualElement>
            <ui:VisualElement class="pc-grid">
                <ui:Button name="books-button" text="Books" class="pc-tile" />
                <ui:Button name="members-button" text="Members" class="pc-tile" />
                <ui:Button name="upgrades-button" text="Upgrades" class="pc-tile" />
                <ui:Button name="settings-button" text="Settings" class="pc-tile" />
            </ui:VisualElement>
            <ui:Label text="click outside the screen or press Esc to log off" class="pc-footer" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
